# Neon (https://neon.tech) da yaratgan PostgreSQL connection string'ingizni shu yerga qo'ying.
# Neon dashboard > Connection Details > "Connection string" dan nusxa oling.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob token (https://vercel.com/docs/storage/vercel-blob)
# Vercel Dashboard > Storage > Blob > Create > Token yaratib, shu yerga qo'ying.
# Format: vercel_blob_rw_xxxxxxxxxxxx
VERCEL_BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
